# STAGING (compose.prod.yaml em /opt/crm-candidaturas-staging). No servidor, copie para .env
# (chmod 600, dono deploy) e troque os valores. Passo a passo em docs/staging.md.
# Gere valores aleatórios com: openssl rand -hex 32

# Projeto Docker próprio: containers, rede e volume separados dos de produção.
COMPOSE_PROJECT_NAME=crm-candidaturas-staging
# Mailpit no ar só aqui (e-mails não saem para a internet).
COMPOSE_PROFILES=mailpit

SITE_ADDRESS=staging-crm.lnmengenharia.com
APP_ENV=staging
# Portas internas (somente loopback) onde o Nginx do host encontra este stack.
PROXY_BIND=127.0.0.1:8082
MAILPIT_BIND=127.0.0.1:8026

# VPS compartilhada: limites menores que os de produção.
API_MEMORY=256m
WEB_MEMORY=192m
POSTGRES_MEMORY=256m
PROXY_MEMORY=64m

POSTGRES_DB=crm
POSTGRES_USER=crm
# Use apenas letras e números (vai dentro da DATABASE_URL). Diferente da produção.
POSTGRES_PASSWORD=troque-por-um-valor-aleatorio

# Diferente da produção: sessões de um ambiente não valem no outro.
SECRET_KEY=troque-por-um-valor-aleatorio
SESSION_MAX_AGE_SECONDS=43200
LOG_LEVEL=INFO

# Conta administradora (área /admin), sincronizada na subida da API.
ADMIN_EMAIL=

BACKUP_RETENTION_DAYS=3

# Cadastro aberto para testar o fluxo completo (o acesso ao site é restrito pelo Cloudflare Access).
SIGNUP_ENABLED=true

# E-mails capturados pelo Mailpit: https://<SITE_ADDRESS>/mailpit/
SMTP_HOST=mailpit
SMTP_PORT=1025
SMTP_SECURITY=none
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=nao-responda@staging-crm.lnmengenharia.com

# Login com Google desligado no staging (decisão S3a).
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Stripe em modo de TESTE (sk_test_...). Webhook: https://<SITE_ADDRESS>/api/v1/billing/webhook
BILLING_ENABLED=true
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
