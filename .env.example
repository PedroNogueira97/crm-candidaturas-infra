# Ambiente LOCAL (compose.yaml). Copie para .env e troque os valores.
# Gere valores aleatórios com: openssl rand -hex 32

HTTP_PORT=8080

POSTGRES_DB=crm
POSTGRES_USER=crm
# Use apenas letras e números (vai dentro da DATABASE_URL).
POSTGRES_PASSWORD=troque-por-um-valor-aleatorio

SECRET_KEY=troque-por-um-valor-aleatorio
SESSION_MAX_AGE_SECONDS=43200
LOG_LEVEL=INFO

# Conta operacional criada por: docker compose run --rm api python scripts/bootstrap_user.py
INITIAL_USER_EMAIL=owner@example.com
INITIAL_USER_PASSWORD=troque-por-pelo-menos-12-caracteres
# Conta administradora (área /admin), sincronizada na subida da API.
ADMIN_EMAIL=owner@example.com
# E-mails do ambiente local caem no Mailpit: http://localhost:8025

# Assinatura pelo Stripe, com chaves de TESTE. Para receber os webhooks localmente:
#   docker compose --profile stripe run --rm stripe-cli listen --print-secret
# copie o whsec_... para STRIPE_WEBHOOK_SECRET e suba com: docker compose --profile stripe up -d
BILLING_ENABLED=false
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
