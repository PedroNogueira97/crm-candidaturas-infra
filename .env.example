# Ambiente LOCAL (compose.yaml). Copie para .env e troque os valores.
# Gere valores aleatórios com: openssl rand -hex 32

HTTP_PORT=8080

POSTGRES_DB=crm
POSTGRES_USER=crm
# Use apenas letras e números (vai dentro da DATABASE_URL).
POSTGRES_PASSWORD=troque-por-um-valor-aleatorio

SECRET_KEY=troque-por-um-valor-aleatorio
SESSION_MAX_AGE_SECONDS=43200
LOG_LEVEL=INFO

# Conta operacional criada por: docker compose run --rm api python scripts/bootstrap_user.py
INITIAL_USER_EMAIL=owner@example.com
INITIAL_USER_PASSWORD=troque-por-pelo-menos-12-caracteres
