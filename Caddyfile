# Proxy único: frontend e API na mesma origem.
# SITE_ADDRESS = ":80" (HTTP interno). Em produção, o Nginx do host termina o HTTPS
# e encaminha para este Caddy em loopback.
{
	servers {
		# Aceita X-Forwarded-* (proto https, IP do cliente) vindos do Nginx do host,
		# que chega pela rede privada do Docker. Leitura da direita para a esquerda.
		trusted_proxies static private_ranges
		trusted_proxies_strict
	}
}

{$SITE_ADDRESS} {
	encode zstd gzip

	# Correlação de logs (docs/observabilidade.md): o mesmo X-Request-ID no log do Caddy e no
	# da API. Em produção o Nginx do host já envia um; sem ele (ambiente local), o Caddy gera.
	@sem_request_id not header X-Request-ID *
	request_header @sem_request_id X-Request-ID {http.request.uuid}
	# O log registra os cabeçalhos originais; o id efetivo vai num campo próprio.
	log_append request_id {http.request.header.X-Request-ID}

	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		Referrer-Policy "strict-origin-when-cross-origin"
		Permissions-Policy "camera=(), microphone=(), geolocation=()"
		-Server
	}

	# Readiness da API (inclui conexão com o PostgreSQL), usada pelo deploy e monitoramento.
	handle /api/health {
		rewrite * /ready
		reverse_proxy api:8000
	}

	handle /api/* {
		reverse_proxy api:8000
	}

	handle {
		reverse_proxy web:3000
	}

	# Sem dados pessoais (docs/observabilidade.md): a query string (busca, filtros) e o Referer
	# saem do log. Cookie e Authorization já são ocultados pelo Caddy por padrão.
	log {
		output stdout
		format filter {
			wrap json
			fields {
				request>uri regexp "\?.*$" "?[removido]"
				request>headers>Referer delete
			}
		}
	}
}
