# PRODUÇÃO (compose.prod.yaml). No servidor, copie para .env (chmod 600) e troque os valores.
# Gere valores aleatórios com: openssl rand -hex 32

SITE_ADDRESS=crm-candidatura.lnmengenharia.com

# Porta interna (somente loopback) onde o Nginx do host encontra este stack.
PROXY_BIND=127.0.0.1:8081

POSTGRES_DB=crm
POSTGRES_USER=crm
# Use apenas letras e números (vai dentro da DATABASE_URL).
POSTGRES_PASSWORD=troque-por-um-valor-aleatorio

SECRET_KEY=troque-por-um-valor-aleatorio
SESSION_MAX_AGE_SECONDS=43200
LOG_LEVEL=INFO

# Conta do administrador, criada uma única vez por scripts/bootstrap-admin.sh.
# Depois da criação, apague INITIAL_USER_PASSWORD deste arquivo.
INITIAL_USER_EMAIL=
INITIAL_USER_PASSWORD=

# Conta administradora (área /admin). Sincronizada na subida da API: este e-mail vira admin
# e qualquer outro admin volta a usuário comum. Vazio = nada muda. Nunca vai para o Git.
ADMIN_EMAIL=

# Backups: dias de retenção dos dumps locais em ./backups
BACKUP_RETENTION_DAYS=14

# Cadastro público. Deixe false até a assinatura (Stripe) e a LGPD estarem no ar.
SIGNUP_ENABLED=false

# E-mail transacional (SMTP próprio). Porta 587 + starttls ou 465 + ssl.
# Sem SMTP_HOST, os e-mails não saem e o log registra email.skipped.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURITY=starttls
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
